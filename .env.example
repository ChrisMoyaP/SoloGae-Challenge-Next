# ============================================================
# SoloGae — variables de entorno (EJEMPLO, sin credenciales)
# Copia a .env.local (local) o configúralas en Vercel > Settings > Environment Variables.
# NUNCA subas valores reales al repositorio.
# ============================================================

# ----- Periodo del torneo (obligatorias, sin valores por defecto) -----
# Formato: ISO 8601 con offset explícito (±HH:MM o Z). Intervalo [START, END):
# END es el primer instante que YA NO cuenta (la UI muestra END - 1 s, p. ej. 30 nov 23:59:59).
# Son NEXT_PUBLIC_*: Next.js las incrusta en el build (cliente y servidor). Cambiarlas
# requiere un nuevo build/redeploy; cambiar el valor en Vercel sin redeploy NO tiene efecto.
# Chile (America/Santiago) está en horario de verano (UTC-3) en noviembre-enero, por eso -03:00.

NEXT_PUBLIC_EVENT_NAME="SoloGae 2"

# Periodo de PRUEBAS (noviembre 2026):
NEXT_PUBLIC_EVENT_START=2026-11-23T00:00:00-03:00
NEXT_PUBLIC_EVENT_END=2026-12-01T00:00:00-03:00

# Periodo OFICIAL provisional (enero 2027) — descomentar y comentar el de pruebas:
# NEXT_PUBLIC_EVENT_START=2027-01-01T00:00:00-03:00
# NEXT_PUBLIC_EVENT_END=2027-02-01T00:00:00-03:00

# ----- Servicios externos (completar solo en .env.local / Vercel) -----
DATABASE_URL=
RIOT_API_KEY=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# ----- Endpoints administrativos (Authorization: Bearer <secreto>) -----
# Si no están definidos, los endpoints admin responden 401 (fallan cerrado).
SNAPSHOT_SECRET=
CRON_SECRET=

# ----- Solo para scripts/*.ps1 (variables de entorno del sistema, no del build) -----
# SOLOGAE_BASE_URL=http://localhost:3000
